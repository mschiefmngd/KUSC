rules_version = '2';

// KUSC 회원 사이트 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 통째로 붙여넣고 '게시'
//
// 원칙
// - 회원은 자기 정보만 읽고 고칠 수 있다
// - 학회원 등급은 운영진이 올린 명단(roster)과 맞을 때만 얻을 수 있다
// - 명단 한 줄은 한 계정만 연결할 수 있다
// - 운영진(admins)은 전체를 볼 수 있다

service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    // 학회원이라고 적었다면, 명단 문서에 내 계정이 연결돼 있어야 한다 (같은 요청 안의 변경 포함)
    function claimOk(d) {
      return d.rosterId is string
        && getAfter(/databases/$(db)/documents/roster/$(d.rosterId)).data.get('uid', null) == request.auth.uid;
    }
    function roleOk(d) {
      return d.role == 'general' || (d.role == 'member' && claimOk(d));
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && roleOk(request.resource.data);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && roleOk(request.resource.data)
            && (request.resource.data.role == resource.data.role || resource.data.role == 'general'));
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /roster/{id} {
      allow get: if signedIn();
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
            && ((resource.data.get('uid', null) == null && request.resource.data.uid == request.auth.uid)
                || (resource.data.get('uid', null) == request.auth.uid && request.resource.data.uid == null)));
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
